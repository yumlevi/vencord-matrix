# Disorder Vencord local-file installer for macOS and Linux.
# Download Disorder-Setup.zip, verify its published SHA-256 through a trusted
# channel, extract it, and run this file locally. Never pipe it from a network.
# The deterministic macOS ASAR writer is ported from Vencord Installer v1.4.0
# app_asar.go (GPL-3.0), Copyright Vencord contributors.

set -eu
umask 077

if [ "$#" -ne 0 ]; then
    printf '%s\n' 'Disorder installation stopped safely (ARGUMENTS). This installer accepts no arguments.' >&2
    exit 1
fi

PYTHON_BIN=""
for candidate in python3 /usr/bin/python3; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
        PYTHON_BIN="$candidate"
        break
    fi
done
if [ -z "$PYTHON_BIN" ]; then
    printf '%s\n' 'Disorder installation stopped safely (PYTHON). Python 3.9 or newer is required; nothing was installed.' >&2
    exit 1
fi

exec "$PYTHON_BIN" - <<'PY'
